<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.testplatform.mapper.TestCaseMapper">

    <sql id="Base_Column_List">
        id, project_id, name, content, create_time, update_time
    </sql>

    <select id="selectByProjectId" resultType="TestCase">
        SELECT
        <include refid="Base_Column_List"/>
        FROM test_case
        <where>
            <if test="projectId != null and projectId != ''">
                AND project_id = #{projectId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                OR content LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY id DESC
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

    <select id="countByProjectId" resultType="long">
        SELECT COUNT(1)
        FROM test_case
        <where>
            <if test="projectId != null and projectId != ''">
                AND project_id = #{projectId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                OR content LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <select id="selectById" resultType="TestCase">
        SELECT
        <include refid="Base_Column_List"/>
        FROM test_case
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="TestCase" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO test_case (project_id, name, content, create_time, update_time)
        VALUES (#{projectId}, #{name}, #{content}, #{createTime}, #{updateTime})
    </insert>

    <update id="update" parameterType="TestCase">
        UPDATE test_case
        <set>
            <if test="projectId != null and projectId != ''">project_id = #{projectId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="content != null">content = #{content},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM test_case WHERE id = #{id}
    </delete>

    <delete id="deleteByProjectId">
        DELETE FROM test_case WHERE project_id = #{projectId}
    </delete>

</mapper>
